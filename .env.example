# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，不会被提交
# ---------- 数据库 ----------
PGHOST=localhost
PGPORT=5432
PGDATABASE=cart
PGUSER=cart
PGPASSWORD=change_me_local_only

# ---------- OpenAI ----------
OPENAI_BASE_URL=https://endpoint.greatrouter.com
OPENAI_API_KEY=sk-gr-xxxxxxxxxxxxxxxx

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# 方案预算按 Claude Sonnet 5 测算（¥20.2/M 输入，¥101/M 输出）
CART_LLM_MODEL=claude-sonnet-5
CART_LLM_EFFORT=high
# 单日成本上限（人民币），超过后 llm.py 抛错中止，防止批量跑飞
CART_LLM_DAILY_CAP_CNY=800

# ---------- OpenRouter（所有调用共用此 key，包括 Jev） ----------
OPENROUTER_API_KEY=
# OPENAI_BASE_URL 指向 https://openrouter.ai/api/v1 时也使用上面的 key
# 无需把该 key 再填入 OPENAI_API_KEY
CART_JEV_MODEL=typesafe/jev-1.14

# ---------- 存储 ----------
CART_DATA_ROOT=./data
