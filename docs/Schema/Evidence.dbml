Table evidence {
  record_id uuid [pk, not null]
  source_type varchar [not null, note: '证据来源类型。可选值：public_database、literature、patent、internal_data']
  source_id varchar [not null, note: '外部来源 ID，例如 DOI、专利号、数据库登录号或内部批次号。']
  citation varchar [note: '该证据对应的引用信息。']
  evidence_level varchar [note: '证据等级；具体分级值由统一证据分级规范定义。']
  experimental_conditions json [note: '产生该证据时的实验条件。']
  applicable_scenario varchar [note: '该证据或结果适用的场景。']
  contrary_evidence boolean [ note: '该记录是否属于与主要结论相反的证据。']
  time_of_upload date [note: '源數據上傳時間']
  time_of_download date [note: '數據下載時間']

  "binder.binder_id" uuid [not null, ref: > binder.binder_id, note: '该证据对应的 Binder ID。']
  "binder.epitope" json [note: 'Binder 识别的表位。']
  "binder.binding_site" json [note: 'Binder 的结合位点信息。']
  "binder.kd" decimal [note: '平衡解离常数 Kd。单位：nM；检查：kd >= 0']
  "binder.kon" decimal [note: '结合速率常数 Kon。单位：1/(M*s)；检查：kon >= 0']
  "binder.koff" decimal [note: '解离速率常数 Koff。单位：1/s；检查：koff >= 0']
  "binder.measurement_method" varchar [note: '亲和力或动力学参数的测量方法。可选值：SPR、BLI']
  "binder.measurement_conditions" json [note: 'Kd、Kon、Koff 等测量值对应的具体测量条件。']
  "binder.cross_reactivity_protein" json [note: '蛋白水平的交叉反应性信息。']
  "binder.cross_reactivity_cell" json [note: '细胞水平的交叉反应性信息。']
  "binder.species_reactivity" json [note: '对人、鼠、猴等不同物种的反应性信息。']
  "binder.tm" decimal [note: '热稳定性指标 Tm。单位：°C']
  "binder.viscosity" decimal [note: '黏度测量结果。检查：viscosity >= 0']
  "binder.aggregation_tendency" varchar [note: '聚集倾向。']
  "binder.solubility" varchar [note: '溶解度。']
  "binder.hydrophobicity" decimal [note: '疏水性指标。']
  "binder.charge" decimal [note: '电荷相关指标。']
  "binder.immunogenicity_ada_risk" varchar [note: '免疫原性或抗药抗体（ADA）风险信息。']

  "car.car_id" uuid [not null, ref: > car.car_id, note: '该证据对应的 CAR backbone ID。']
  "car.coexpressed_proteins" json [note: '可选字符串数组：该实验组额外共表达的工程化蛋白，如 mbIL-15、CXCR5；不含内源蛋白、外加因子、CAR自身结构域或T2A/P2A。明确无共表达用[]，未知用null；每条相关证据均记录，汇总和去重须区分共表达组合。表达方式限定见applicable_scenario。']
  "car.activation_speed" varchar [note: 'CAR 激活速度。']
  "car.metabolic_state" varchar [note: 'CAR-T 细胞的代谢状态，例如糖酵解或氧化代谢。可选值：glycolytic、oxidative']
  "car.expansion_capacity" varchar [note: 'CAR-T 细胞的扩增能力。']
  "car.tscm_ratio" json [note: '干细胞样记忆 T 细胞（Tscm）比例；measurement，保留分母及门控定义']
  "car.tcm_ratio" json [note: '中央记忆 T 细胞（Tcm）比例；measurement，保留分母及门控定义']
  "car.tem_ratio" json [note: '效应记忆 T 细胞（Tem）比例；measurement，保留分母及门控定义']
  "car.teff_ratio" json [note: '效应 T 细胞（Teff）比例；measurement，保留分母及门控定义']
  "car.persistence" varchar [note: 'CAR-T 细胞的持久性。']
  "car.exhaustion_phenotype" varchar [note: '耗竭表型，与工艺侧同定义']
  "car.treg_phenotype" varchar [note: 'Treg 相关表型，与工艺侧同定义']
  "car.tonic_signaling_tendency" varchar [note: 'CAR 的 tonic signaling 倾向。']
  "car.geometric_length" decimal [note: 'CAR 相关模块或构型的几何长度信息。检查：geometric_length >= 0']
  "car.epitope_distance_effect" varchar [note: '构型对表位距离相关效果的影响。']
  "car.immune_synapse_effect" varchar [note: '构型对免疫突触形成或性质的影响。']
  "car.tonic_signaling_effect" varchar [note: '构型对 tonic signaling 的影响。']
  "car.compatible_modules" json [note: '已观察或报告为可兼容的模块组合。']
  "car.incompatible_modules" json [note: '已观察或报告为不兼容的模块组合。']
  "car.assembly_rules" json [note: 'CAR 模块装配规则或约束。']

  "manufacturing.manufacturing_id" uuid [not null, ref: > manufacturing.manufacturing_id, note: '该证据对应的制造工艺 ID。']
  "manufacturing.cell_viability" decimal [note: '细胞活率。单位：%；检查：0 <= cell_viability <= 100']
  "manufacturing.transduction_efficiency" decimal [note: '转导效率。单位：%；检查：0 <= transduction_efficiency <= 100']
  "manufacturing.car_positive_ratio" json [note: 'CAR 表达阳性细胞比例；measurement，保留门控分母；与同一定义的转导效率不重复记录']
  "manufacturing.turbidity" json [note: '制剂浑浊程度：observation、value（measurement）、method；不等同无菌结果']
  "manufacturing.ifn_gamma_release" json [note: '体外 IFN-γ 分泌或释放结果；measurement，保留实际单位及实验条件']
  "manufacturing.vcn" decimal [note: '载体拷贝数（VCN）。单位：copies/cell；检查：vcn >= 0']
  "manufacturing.cd3_positive_ratio" decimal [note: 'CD3+ 细胞比例。单位：%；检查：0 <= cd3_positive_ratio <= 100']
  "manufacturing.tscm_ratio" json [note: '干细胞样记忆 T 细胞（Tscm）比例；measurement，保留分母及门控定义']
  "manufacturing.tcm_ratio" json [note: '中央记忆 T 细胞（Tcm）比例；measurement，保留分母及门控定义']
  "manufacturing.tem_ratio" json [note: '效应记忆 T 细胞（Tem）比例；measurement，保留分母及门控定义']
  "manufacturing.teff_ratio" json [note: '效应 T 细胞（Teff）比例；measurement，保留分母及门控定义']
  "manufacturing.exhaustion_phenotype" varchar [note: '产品细胞的耗竭表型。']
  "manufacturing.treg_phenotype" varchar [note: '产品细胞的 Treg 相关表型。']
  "manufacturing.sterility" boolean [note: '无菌检测：true 阳性（检出微生物），false 阴性，未报告 null。']
  "manufacturing.mycoplasma" boolean [note: '支原体检测：true 阳性，false 阴性，未报告 null。']
  "manufacturing.endotoxin" varchar [note: '内毒素检测结果。']
  "manufacturing.killing_activity" json [note: '杀伤活性：target_cell_line、effector_target_ratio（measurement，E/T）、duration（measurement）、method']
  "manufacturing.cytokine_release" json [note: '其他细胞因子释放结果；IFN-γ 单独记录在 ifn_gamma_release。']

  outcomes json [note: '该 ABC 组合在该实验中的结果，如杀伤率、细胞因子释放、肿瘤抑制、存活、扩增、持续性或毒性等。']

  indexes {
    source_type
    source_id
    "binder.binder_id"
    "car.car_id"
    "manufacturing.manufacturing_id"
  }

  // Animal and clinical evidence; nested field definitions are authoritative in Evidence.yaml.
  "study_type" varchar [note: 'Study setting for this evidence record: in_vitro, animal, clinical, computational, or other. Classify the specific experiment or cohort, not the highest development stage mentioned in the document.']
  "study_source" json [note: 'Publication metadata for this study. Keep source identity and exact evidence locations in source_id and citation; a trial registration number does not replace either.']
  "animal.model" json [note: 'Animal species, strain, sex, age, disease or tumor model, and immune status explicitly reported for this experiment. Do not infer an animal model from a cell-line name.']
  "animal.study_groups" json [note: 'Animal study arms and their reported sample sizes, comparators, pretreatment baseline, interventions, follow-up, randomization, and blinding. One item per source-defined group.']
  "animal.efficacy_outcomes" json [note: 'Animal efficacy observations such as tumor burden, tumor inhibition, and survival. One item per group, endpoint, analysis population, and assessment time. Do not apply human response criteria.']
  "animal.safety_outcomes" json [note: 'Animal safety observations such as weight change, organ toxicity, histopathology, or death. Preserve the actual endpoint, group, denominator, and window; do not assume clinical toxicity grades.']
  "animal.cell_kinetics" json [note: 'Animal in-vivo expansion, distribution, and persistence observations. Separate groups, tissues, assays, readouts, units, and time points; do not place human kinetics here.']


  // Named clinical metrics; nested input contracts are defined in Evidence.yaml.
  "clinical.trial_phase" varchar [note: 'Reported clinical trial phase only, such as phase I or I/II. Do not infer it from sample size.']
  "clinical.trial_design" varchar [note: 'Trial design features only: single/multicenter, single-arm or comparative, randomization, blinding and dose-escalation design. Do not add baseline, endpoint results, counts or assessment criteria here.']
  "clinical.enrolled_count" int [note: 'Number enrolled in the trial, explicitly reported. Not the treated, evaluable or event-specific denominator.']
  "clinical.infused_count" int [note: 'Number actually receiving the CAR-T infusion, explicitly reported. Not the enrolled or endpoint-specific evaluable count.']
  "clinical.patient_baseline" json [note: 'Pretreatment characteristics and treatment context for one source-defined patient or cohort. Identify the subject in clinical.measurement_conditions. Store a baseline observation once; do not recreate it merely to accompany every later sample/result.']
  "clinical.measurement_conditions" json [note: 'One shared conditions object for the clinical metrics on this evidence row, following binder.measurement_conditions. Populate only conditions relevant to the recorded metric. Split rows when populations, denominators, assessment times or assays differ. Keep provenance in source_id/citation and baseline in patient_baseline.']
  "clinical.response" varchar [note: 'Reported categorical response for an individual patient or explicitly identified representative case, such as CR, CRi, PR or sCR. Keep MRD status in clinical.mrd_status. Do not turn one patient response into a 100% rate.']
  "clinical.orr" json [note: 'Objective response rate explicitly reported as ORR. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.cr_rate" json [note: 'Complete-remission/response rate explicitly reported as CR; not CRi. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.cri_rate" json [note: 'Complete remission with incomplete count recovery, explicitly reported as CRi. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.cr_or_cri_rate" json [note: 'Combined CR-or-CRi proportion/count only when explicitly reported as that combined endpoint; not CR alone or an assumed ORR. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.pr_rate" json [note: 'Partial-response/remission rate explicitly reported as PR. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.mrd_negative_rate" json [note: 'MRD-negative rate for the exact reported analysis population; do not silently equate MRD-negative CR and all MRD negativity. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.mrd_negative_cr_rate" json [note: 'MRD-negative complete remission/response proportion/count explicitly reported as that combined endpoint; preserve the source response definition and do not substitute ORR or MRD negativity alone. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.relapse_rate" json [note: 'Relapse proportion/count for the reported follow-up population. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.disease_free_rate" json [note: 'Source-reported disease-free proportion/count at the specified assessment; not a Kaplan–Meier DFS estimate unless explicitly reported as such. Accept only the reported rate and/or explicit event count and denominator. No calculated ORR from component rates, count back-calculation, or patient-level response labels. Shared conditions are recorded once in clinical.measurement_conditions.']
  "clinical.mrd_status" varchar [note: 'Explicitly reported individual MRD status only; do not infer negativity from CR or an unreported detection threshold.']
  "clinical.mrd_level" json [note: 'Actual measured MRD burden in the reported unit. Not the negativity threshold or proportion of patients with MRD negativity.']
  "clinical.dor" json [note: 'Source-reported duration of response duration or explicit not-reached/not-estimable status. Preserve time origin and endpoint definition in measurement_conditions. No conversion of landmark percentages into durations.']
  "clinical.pfs" json [note: 'Source-reported progression-free survival duration or explicit not-reached/not-estimable status. Preserve time origin and endpoint definition in measurement_conditions. No conversion of landmark percentages into durations.']
  "clinical.efs" json [note: 'Source-reported event-free survival duration or explicit not-reached/not-estimable status. Preserve time origin and endpoint definition in measurement_conditions. No conversion of landmark percentages into durations.']
  "clinical.os" json [note: 'Source-reported overall survival duration or explicit not-reached/not-estimable status. Preserve time origin and endpoint definition in measurement_conditions. No conversion of landmark percentages into durations.']
  "clinical.pfs_rate" json [note: 'Explicitly reported landmark PFS estimate. Keep landmark/time origin in measurement_conditions.assessment_time; do not compute it from raw counts or substitute a median survival duration. Kaplan–Meier estimates need not have an event-count numerator.']
  "clinical.efs_rate" json [note: 'Explicitly reported landmark EFS estimate. Keep landmark/time origin in measurement_conditions.assessment_time; do not compute it from raw counts or substitute a median survival duration. Kaplan–Meier estimates need not have an event-count numerator.']
  "clinical.os_rate" json [note: 'Explicitly reported landmark OS estimate. Keep landmark/time origin in measurement_conditions.assessment_time; do not compute it from raw counts or substitute a median survival duration. Kaplan–Meier estimates need not have an event-count numerator.']
  "clinical.crs" json [note: 'Only the reported cytokine release syndrome observation: grade, incidence/count, onset, duration/recovery and management. Grading system, window and relatedness belong once in measurement_conditions. Do not repeat the event name or a generic event definition in this object. Do not copy the same patient event into every later sampling row.']
  "clinical.icans" json [note: 'Only the reported immune effector cell-associated neurotoxicity syndrome observation: grade, incidence/count, onset, duration/recovery and management. Grading system, window and relatedness belong once in measurement_conditions. Do not repeat the event name or a generic event definition in this object. Do not copy the same patient event into every later sampling row.']
  "clinical.dlt" json [note: 'Only the reported dose-limiting toxicity observation: grade, incidence/count, onset, duration/recovery and management. Grading system, window and relatedness belong once in measurement_conditions. Do not repeat the event name or a generic event definition in this object. Do not copy the same patient event into every later sampling row.']
  "clinical.ice_score" json [note: 'Reported ICE score only. Do not infer the score from ICANS grade or infer ICANS grade from this score.']
  "clinical.cytopenias" json [note: 'One item per specific event and grade within hematological cytopenias, including neutropenia, thrombocytopenia, anemia or lymphopenia. Only event observations belong here. Separate records for different populations or observation windows. Preserve event hierarchy without summing overlapping grades.']
  "clinical.infections" json [note: 'One item per specific event and grade within reported clinical infections, retaining organism/site/type when supplied. Only event observations belong here. Separate records for different populations or observation windows. Preserve event hierarchy without summing overlapping grades.']
  "clinical.other_adverse_events" json [note: 'One item per specific event and grade within other named clinical adverse events, including HLH/MAS, B-cell aplasia, hypogammaglobulinemia, TLS or secondary malignancy; excludes CRS, ICANS, DLT, cytopenias and infections which have dedicated fields. Only event observations belong here. Separate records for different populations or observation windows. Preserve event hierarchy without summing overlapping grades.']
  "clinical.ae" json [note: 'Overall proportion/count of patients with AE, only when explicitly reported at that classification level. Individual named adverse events belong in their dedicated event fields; do not sum events or grades to generate this overall result.']
  "clinical.sae" json [note: 'Overall proportion/count of patients with SAE, only when explicitly reported at that classification level. Individual named adverse events belong in their dedicated event fields; do not sum events or grades to generate this overall result.']
  "clinical.cmax" json [note: 'Reported peak human CAR-T abundance/exposure readout. Distinguish qPCR transgene copies, flow-cytometric counts and percentages in measurement_conditions; a single sampled non-peak measurement is not Cmax.']
  "clinical.tmax" json [note: 'Reported time to peak, preserving the infusion or other source time origin. Not an assumed day 7–14 range.']
  "clinical.auc" json [note: 'Reported CAR-T exposure AUC. Preserve actual integration interval, assay and analyte in measurement_conditions; do not default to AUC(0–28d).']
  "clinical.car_t_cell_count" json [note: 'Human CAR-T cell count or concentration at the specified specimen/time. Not transgene copies, percentage, peak by assumption or a manufacturing cell yield.']
  "clinical.car_t_ratio" json [note: 'Human CAR-positive cell percentage or proportion at the specified specimen/time; preserve the gated denominator in raw/analyte. Not infused-product CAR-positive ratio or a peak by assumption.']
  "clinical.transgene_level" json [note: 'Human in-vivo transgene abundance measured by qPCR or another reported method, with original denominator/unit. Not manufacturing VCN or flow-cytometric cell counts.']
  "clinical.persistence" json [note: 'Reported human CAR-T persistence duration and/or qualitative detection status. A single positive sample on day X is not automatically an X-day measured persistence duration; retain that observation without inventing a duration.']
  "clinical.cytokine_levels" json [note: 'Human specimen cytokine concentrations or explicitly reported detection status associated with clinical observation. One item per cytokine; use common specimen, time and assay conditions. These are biomarkers, not adverse-event incidences or in-vitro manufacturing release assays.']
  "clinical.kinetics_comparison" varchar [note: 'Explicit qualitative comparison of human CAR-T expansion/exposure/persistence between source-defined groups when exact metric values are unavailable. Identify the metric and actual comparison; do not repeat numerical results already stored in cmax/tmax/auc/persistence.']
  "clinical.assessment_schedule" varchar [note: 'Source-reported study visit schedule/frequency with the assessment names and time origin only. Not observed response values, assay descriptions or repeated full response definitions. Record only when this row documents the schedule; do not copy it into every result. Do not assume D28/M3/M6/M12.']

  Note: '合并 record、binder_evidence、car_evidence 和 manufacturing_evidence 的统一证据表。'
}
