Table evidence {
  record_id uuid [pk, not null]
  source_type varchar [not null, note: '证据来源类型。可选值：public_database、literature、patent、internal_data']
  source_id varchar [not null, note: '外部来源 ID，例如 DOI、专利号、数据库登录号或内部批次号。']
  citation varchar [note: '该证据对应的引用信息。']
  evidence_level varchar [not null, note: '证据等级；具体分级值由统一证据分级规范定义。']
  experimental_conditions json [note: '产生该证据时的实验条件。']
  applicable_scenario varchar [note: '该证据或结果适用的场景。']
  contrary_evidence boolean [not null, default: false, note: '该记录是否属于与主要结论相反的证据。']
  time_of_upload date [note: '源數據上傳時間']
  time_of_download date [note: '數據下載時間']

  "binder.binder_id" uuid [not null, ref: > binder.binder_id, note: '该证据对应的 Binder ID。']
  "binder.epitope" varchar [note: 'Binder 识别的表位。']
  "binder.binding_site" varchar [note: 'Binder 的结合位点信息。']
  "binder.kd" decimal [note: '平衡解离常数 Kd。单位：nM；检查：kd >= 0']
  "binder.kon" decimal [note: '结合速率常数 Kon。单位：1/(M*s)；检查：kon >= 0']
  "binder.koff" decimal [note: '解离速率常数 Koff。单位：1/s；检查：koff >= 0']
  "binder.measurement_method" varchar [note: '亲和力或动力学参数的测量方法。可选值：SPR、BLI']
  "binder.measurement_conditions" json [note: 'Kd、Kon、Koff 等测量值对应的具体测量条件。']
  "binder.cross_reactivity_protein" json [note: '蛋白水平的交叉反应性信息。']
  "binder.cross_reactivity_cell" json [note: '细胞水平的交叉反应性信息。']
  "binder.species_reactivity" json [note: '对人、鼠、猴等不同物种的反应性信息。']
  "binder.tm" decimal [note: '热稳定性指标 Tm。单位：°C']
  "binder.viscosity" decimal [note: '黏度测量结果。检查：viscosity >= 0']
  "binder.aggregation_tendency" varchar [note: '聚集倾向。']
  "binder.solubility" varchar [note: '溶解度。']
  "binder.hydrophobicity" decimal [note: '疏水性指标。']
  "binder.charge" decimal [note: '电荷相关指标。']
  "binder.immunogenicity_ada_risk" varchar [note: '免疫原性或抗药抗体（ADA）风险信息。']

  "car.car_id" uuid [not null, ref: > car.car_id, note: '该证据对应的 CAR backbone ID。']
  "car.activation_speed" varchar [note: 'CAR 激活速度。']
  "car.metabolic_state" varchar [note: 'CAR-T 细胞的代谢状态，例如糖酵解或氧化代谢。可选值：glycolytic、oxidative']
  "car.expansion_capacity" varchar [note: 'CAR-T 细胞的扩增能力。']
  "car.memory_phenotype" varchar [note: 'CAR-T 细胞的记忆表型。']
  "car.persistence" varchar [note: 'CAR-T 细胞的持久性。']
  "car.exhaustion_risk" varchar [note: 'CAR-T 细胞的耗竭风险。']
  "car.tonic_signaling_tendency" varchar [note: 'CAR 的 tonic signaling 倾向。']
  "car.geometric_length" decimal [note: 'CAR 相关模块或构型的几何长度信息。检查：geometric_length >= 0']
  "car.epitope_distance_effect" varchar [note: '构型对表位距离相关效果的影响。']
  "car.immune_synapse_effect" varchar [note: '构型对免疫突触形成或性质的影响。']
  "car.tonic_signaling_effect" varchar [note: '构型对 tonic signaling 的影响。']
  "car.compatible_modules" json [note: '已观察或报告为可兼容的模块组合。']
  "car.incompatible_modules" json [note: '已观察或报告为不兼容的模块组合。']
  "car.assembly_rules" json [note: 'CAR 模块装配规则或约束。']

  "manufacturing.manufacturing_id" uuid [not null, ref: > manufacturing.manufacturing_id, note: '该证据对应的制造工艺 ID。']
  "manufacturing.cell_viability" decimal [note: '细胞活率。单位：%；检查：0 <= cell_viability <= 100']
  "manufacturing.transduction_efficiency" decimal [note: '转导效率。单位：%；检查：0 <= transduction_efficiency <= 100']
  "manufacturing.vcn" decimal [note: '载体拷贝数（VCN）。单位：copies/cell；检查：vcn >= 0']
  "manufacturing.cd3_positive_ratio" decimal [note: 'CD3+ 细胞比例。单位：%；检查：0 <= cd3_positive_ratio <= 100']
  "manufacturing.memory_phenotype" varchar [note: '产品细胞的记忆表型。']
  "manufacturing.exhaustion_phenotype" varchar [note: '产品细胞的耗竭表型。']
  "manufacturing.treg_phenotype" varchar [note: '产品细胞的 Treg 相关表型。']
  "manufacturing.sterility" varchar [note: '无菌检测结果。']
  "manufacturing.mycoplasma" varchar [note: '支原体检测结果。']
  "manufacturing.endotoxin" varchar [note: '内毒素检测结果。']
  "manufacturing.killing_activity" varchar [note: '杀伤活性结果。']
  "manufacturing.cytokine_release" json [note: '细胞因子释放结果。']

  indexes {
    source_type
    source_id
    "binder.binder_id"
    "car.car_id"
    "manufacturing.manufacturing_id"
  }

  Note: '合并 record、binder_evidence、car_evidence 和 manufacturing_evidence 的统一证据表。'
}
