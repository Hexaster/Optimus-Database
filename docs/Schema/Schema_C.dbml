Table manufacturing {
  manufacturing_id uuid [pk, not null, note: '平台内部唯一制造工艺 ID']
  name varchar [note: '制造工艺或工艺版本的名称/代号']
  t_cell_source varchar [note: 'T 细胞来源。可选值：自体、异体']
  cd4_cd8_ratio varchar [note: '起始或目标 CD4:CD8 比例']
  selection_steps json [note: '起始细胞分离或分选步骤，按报告顺序记录；每步包含 input、output、method、reagents（reagent_name、amount：measurement），允许直接分选或分支，不补推中间步骤']
  starting_cell_quality json [note: '激活或基因导入前的投料细胞质量：cell_viability（measurement，%）、memory_phenotype（原文亚型、比例及分母）、measurement_stage（原文测量阶段）；CD4:CD8 比例另存 cd4_cd8_ratio']
  activation_method varchar [note: 'T 细胞激活方式']
  reagents json [note: '制造过程中使用的关键试剂，amount 以 measurement 记录用量、浓度或使用比例及原文单位；不重复记录 selection_steps 中的试剂，无法对应具体步骤的分选试剂仍在此记录；培养基记录在 culture_system.culture_medium']
  vector_type varchar [note: '用于基因导入的载体类型。可选值：慢病毒、逆转录病毒、转座子、电转、CRISPR/Cas9+AAV定点插入']
  moi decimal [note: '感染复数（MOI）。检查：moi >= 0']
  transduction_transfection_conditions json [note: '转导或转染条件：time_after_activation、enhancer_used、spinoculation、contact_duration']
  culture_system json [note: '培养体系：container、culture_mode、openness、automation、culture_medium']
  cytokine_combination json [note: '培养过程中使用的细胞因子组合']
  culture_duration varchar [note: '培养时长']
  cryopreservation_conditions json [note: '冻存条件：medium、dmso_concentration、cell_density、cooling_method、cooling_rate']
  formulation json [note: '制剂：fill_volume、cell_concentration、total_dose']
  corresponding_car_product varchar [note: '来源中报告的对应 CAR 构型或产品信息']

  Note: '制造工艺核心实体表。每个产品/工艺版本对应一条记录。'
}
