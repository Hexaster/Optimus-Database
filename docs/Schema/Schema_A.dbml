Table binder {
  binder_id uuid [pk, not null, note: '平台内部唯一 Binder ID。']
  name varchar [note: 'Binder 的名称或代号。']
  aliases json [note: '該 Binder 的其他名稱']
  scfv_sequence varchar [note: 'scFv 完整氨基酸序列。']
  vh_sequence varchar [note: 'VH 氨基酸序列。']
  vl_sequence varchar [note: 'VL 氨基酸序列。']
  linker varchar [note: '连接 VH 与 VL 的 linker 序列。']
  numbering_scheme varchar [note: '抗体序列编号体系，例如 IMGT、Kabat。']
  fr_cdr_regions json [note: 'FR/CDR 区域及其位置或序列信息。']
  cdr_lengths json [note: '各 CDR 区域的长度。']
  vdj_genes json [note: 'V(D)J 基因信息。']
  germline_origin varchar [note: '胚系来源。']
  somatic_mutations json [note: '体细胞突变信息。']
  target_antigen varchar [note: 'Binder 的靶抗原，例如 GCC、CDH17。']
  glycosylation_sites json [note: '糖基化位点信息。']
  free_cysteines json [note: '游离半胱氨酸信息。']
  humanization_level varchar [note: '人源化程度。']
  structure_template varchar [note: '可用于该 Binder 的结构模板。']
  complex_structure varchar [note: 'Binder 与靶标复合物的结构信息。']

  indexes {
    target_antigen
  }

  Note: 'Binder 核心实体表。一个经实体归一化后的 Binder 对应一条记录。'
}