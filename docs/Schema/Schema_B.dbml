Table car {
  car_id uuid [pk, not null, note: '平台内部唯一 CAR backbone ID。']
  name varchar [note: 'CAR backbone 的名称或代号。']
  modules json [not null, note: '按 CAR 中实际顺序保存的模块列表；每个模块记录模块类型、来源分子、序列与长度。Binder 识别域作为 A 实体独立管理，不参与 B 实体的 backbone 去重。模块类型可选值：linker、hinge、transmembrane_region、costimulatory_domain、CD3zeta、tag、safety_switch；length 单位：aa，检查：length >= 0。']

  Note: 'CAR 骨架核心实体表。一个经归一化后的 CAR backbone 对应一条记录；Binder 作为 A 实体独立管理，后续通过 ABC 组合关联。'
}